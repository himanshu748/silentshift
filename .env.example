# Copy to .env; keep .env and .local outside version control.
# Download the architecture-specific build154 kit from the official AI Hub EAP
# portal, docker load it locally, then copy the EXACT printed image tag here.
IRIS_IMAGE=
WEBGATEWAY_IMAGE=containers.intersystems.com/intersystems/webgateway:2026.1

# Distinct local application accounts. Set unique passwords of at least 12
# characters. No default passwords are supplied. Quote values containing $ or #.
SILENTSHIFT_IRIS_USERNAME=ss-reviewer
SILENTSHIFT_IRIS_PASSWORD=
SILENTSHIFT_VIEWER_USERNAME=ss-viewer
SILENTSHIFT_VIEWER_PASSWORD=
SILENTSHIFT_GATEWAY_PASSWORD=

# Only this local Ollama model and a known local port11434 route are accepted.
# Each native SDK request uses a short-lived server-issued capability; no
# external provider key is required. Bootstrap never invokes a model.
SILENTSHIFT_MODEL=qwen3-silentshift:4b-instruct
SILENTSHIFT_LLM_BASE_URL=http://host.lima.internal:11434/v1/

# Optional local procedural retrieval. Only an explicit local Ollama11434
# route is accepted; embeddings never authorize a transaction's release.
SILENTSHIFT_EMBED_BASE_URL=
SILENTSHIFT_EMBED_MODEL=all-minilm:22m
# Native wait budget:10..120s. The tested resource-constrained local4B setup
# uses120; timeout holds the case and does not prove provider cancellation.
SILENTSHIFT_AGENT_WAIT_SECONDS=60
# Native ready-file feed; 0 is dormant until an operator opts in.
SILENTSHIFT_PARTNER_FILES_ENABLED=0

# Docker Desktop uses this alternate local hostname. Verify reachability
# inside IRIS; do not substitute a remote provider:
# SILENTSHIFT_LLM_BASE_URL=http://host.docker.internal:11434/v1/

SILENTSHIFT_API_URL=http://127.0.0.1:52773/silentshift/api
IRIS_API_ORIGIN=http://127.0.0.1:52773/silentshift

# Live local inference is the default. Recorded playback is only for synthetic scenario A.
SILENTSHIFT_PROVIDER_MODE=live
