# Copy to .env; keep .env and .local outside version control.
# Download the architecture-specific build154 kit from the official AI Hub EAP
# portal, docker load it locally, then copy the EXACT printed image tag here.
IRIS_IMAGE=
WEBGATEWAY_IMAGE=containers.intersystems.com/intersystems/webgateway:2026.1

# Distinct local application accounts. Set unique passwords of at least 12
# characters. No default passwords are supplied. Quote values containing $ or #.
SILENTSHIFT_IRIS_USERNAME=ss-reviewer
SILENTSHIFT_IRIS_PASSWORD=
SILENTSHIFT_VIEWER_USERNAME=ss-viewer
SILENTSHIFT_VIEWER_PASSWORD=
SILENTSHIFT_GATEWAY_PASSWORD=

# Default: local Ollama. All SDK traffic stays behind the internal traced
# gateway. External credentials are used only by its native forwarding host.
# Bootstrap validates configuration but never invokes a model.
SILENTSHIFT_PROVIDER=ollama
SILENTSHIFT_API_KEY=
SILENTSHIFT_MODEL=qwen3-silentshift:4b-instruct
SILENTSHIFT_LLM_BASE_URL=http://host.lima.internal:11434/v1/

# Optional local procedural retrieval. Only an explicit local Ollama11434
# route is accepted; embeddings never authorize a transaction's release.
SILENTSHIFT_EMBED_BASE_URL=
SILENTSHIFT_EMBED_MODEL=all-minilm:22m
# Native wait budget:10..120s. The tested resource-constrained local4B setup
# uses120; timeout holds the case and does not prove provider cancellation.
SILENTSHIFT_AGENT_WAIT_SECONDS=60
# Native ready-file feed; 0 is dormant until an operator opts in.
SILENTSHIFT_PARTNER_FILES_ENABLED=0

# Docker Desktop uses this alternate local hostname. Verify reachability
# inside IRIS:
# SILENTSHIFT_LLM_BASE_URL=http://host.docker.internal:11434/v1/

SILENTSHIFT_API_URL=http://127.0.0.1:52773/silentshift/api
IRIS_API_ORIGIN=http://127.0.0.1:52773/silentshift

# Live local inference is the default. Recorded playback is only for synthetic scenario A.
SILENTSHIFT_PROVIDER_MODE=live

# Bring your own provider: REPLACE the active provider/model/URL/key entries
# above with ONE block below. Do not append duplicate KEY=value entries.
# External service calls may incur charges; no external key is supplied.
# OpenAI (OpenAI-compatible Chat Completions with tools):
# SILENTSHIFT_PROVIDER=openai
# SILENTSHIFT_LLM_BASE_URL=https://api.openai.com/v1/
# SILENTSHIFT_MODEL=<your-tool-capable-model-id>
# SILENTSHIFT_API_KEY=<your-private-openai-key>

# Gemini through Google's documented OpenAI-compatible API:
# SILENTSHIFT_PROVIDER=gemini
# SILENTSHIFT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SILENTSHIFT_MODEL=<your-tool-capable-gemini-model-id>
# SILENTSHIFT_API_KEY=<your-private-gemini-key>

# OpenRouter (model availability and pricing depend on your account):
# SILENTSHIFT_PROVIDER=openrouter
# SILENTSHIFT_LLM_BASE_URL=https://openrouter.ai/api/v1/
# SILENTSHIFT_MODEL=<provider/model-id-with-tool-support>
# SILENTSHIFT_API_KEY=<your-private-openrouter-key>

# Another deployment implementing OpenAI-compatible chat completions + tools:
# SILENTSHIFT_PROVIDER=openai-compatible
# SILENTSHIFT_LLM_BASE_URL=https://your-provider.example/v1/
# SILENTSHIFT_MODEL=<your-model-id>
# SILENTSHIFT_API_KEY=<your-private-provider-key>
# HTTPS is required remotely. HTTP is accepted only for explicit local hosts.
# Replay mode uses the frozen Qwen responses and never sends an external key.
